# Frontend talks only to NestJS. Never put database credentials or secret keys here.
# Empty uses same-origin /api; Vite proxies it to NestJS during development.
VITE_API_BASE_URL=

# Supabase Auth only. Both are public configuration, never database credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
