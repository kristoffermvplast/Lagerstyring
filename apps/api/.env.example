# Copy to apps/api/.env. Never commit real secrets.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
# Required in production; without this, local liveness works and readiness returns 503.
DATABASE_URL=
# Hosted connections require TLS. Set to disable only for loopback local Supabase.
DATABASE_SSL_MODE=require
# Optional absolute path to the Supabase CA certificate (not committed).
DATABASE_CA_FILE=
# Optional PEM from the project's Supabase SSL Configuration. Runtime writes it
# only when DATABASE_CA_FILE=/app/certs/supabase-ca.crt (Docker runtime).
DATABASE_CA_PEM=
DATABASE_POOL_MAX=5
# Public project URL only; Auth is implemented in Phase 2.
SUPABASE_URL=https://puwyontrchonoepisgun.supabase.co

# Phase 2: public/anon Supabase API key used only for Auth token verification.
# Never use service_role here. Missing key keeps protected routes unavailable.
SUPABASE_PUBLISHABLE_KEY=
