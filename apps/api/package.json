{
  "name": "@lager/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run build && concurrently -k \"tsc --watch --preserveWatchOutput -p tsconfig.json\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  }
}
